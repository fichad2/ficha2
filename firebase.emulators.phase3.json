    "firestore": {
      "host": "127.0.0.1",
      "port": 18080
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 15001
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 14400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 14500
