    {
      "source": "functions",
      "codebase": "phase3-local",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*-debug.log"
      ],
      "predeploy": [
        "node scripts/block-phase3-deploy.mjs"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.phase3-local.rules",
    "predeploy": [
      "node scripts/block-phase3-deploy.mjs"
    ]
  },
  "emulators": {
